        $data = $this->normalizeAmenityInput($_POST);
        $iconKeys = $this->getAllowedAmenityIconKeys();

        if ($id > 0 && !AmenityModel::getById($id)) {
            setFlash('admin_amenity_error', 'Tiện ích cần cập nhật không tồn tại.');
            redirectTo('admin-amenities');
        }

