                            </label>
                        </div>
                    </div>
                    <?php else: ?>
                    <div class="relative">
                        <input
                            id="<?= e($fieldId) ?>"
                            type="<?= e($inputType) ?>"
                            name="settings[<?= e($fieldKey) ?>]"
                            value="<?= e($fieldValue) ?>"
                            placeholder="<?= e($field['placeholder'] ?? '') ?>"
