const prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

const mobileMenuBtn = document.getElementById('mobileMenuBtn');
const mobileMenu = document.getElementById('mobileMenu');
const mobileMenuBackdrop = document.getElementById('mobileMenuBackdrop');
const mobileMenuCloseBtn = document.getElementById('mobileMenuCloseBtn');

function openMobileMenu() {
    if (!mobileMenu || !mobileMenuBackdrop) {
        return;
    }
    mobileMenuBackdrop.classList.remove('hidden');
    mobileMenu.classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden';
}

function closeMobileMenu() {
    if (!mobileMenu || !mobileMenuBackdrop) {
        return;
    }
    mobileMenu.classList.add('translate-x-full');
    mobileMenuBackdrop.classList.add('hidden');
    document.body.style.overflow = '';
}

if (mobileMenuBtn && mobileMenu && mobileMenuBackdrop) {
    mobileMenuBtn.addEventListener('click', () => {
        if (mobileMenu.classList.contains('translate-x-full')) {
            openMobileMenu();
        } else {
            closeMobileMenu();
        }
    });
    mobileMenuBackdrop.addEventListener('click', closeMobileMenu);
    if (mobileMenuCloseBtn) {
        mobileMenuCloseBtn.addEventListener('click', closeMobileMenu);
    }
    window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            closeMobileMenu();
        }
    });
}

/**
 * Hiệu ứng reveal chỉ chạy khi trình duyệt hỗ trợ IntersectionObserver.
 * Nếu không hỗ trợ, phần tử vẫn được hiện ngay để tránh giao diện "mất nội dung".
 */
const revealTargets = document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale, .stagger-children');
if (prefersReducedMotion) {
    revealTargets.forEach((element) => element.classList.add('active'));
} else if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add('active');
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

    revealTargets.forEach((element) => observer.observe(element));
} else {
    revealTargets.forEach((element) => element.classList.add('active'));
}

// Bộ đếm số liệu cho home/intro, không phụ thuộc framework.
function animateCounter(element) {
    const target = parseFloat(element.getAttribute('data-target'));
    if (Number.isNaN(target)) {
        element.textContent = element.getAttribute('data-target') || '0';
        return;
    }

    const duration = 2000;
    const stepTime = 20;
    const steps = duration / stepTime;
    const increment = target / steps;
    let current = 0;

    const timer = setInterval(() => {
        current += increment;
        if (current >= target) {
            current = target;
            clearInterval(timer);
        }
        element.textContent = Math.floor(current);
    }, stepTime);
}

if ('IntersectionObserver' in window) {
    const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting && !entry.target.dataset.counted) {
                entry.target.dataset.counted = 'true';
                animateCounter(entry.target);
            }
        });
    }, { threshold: 0.5 });

    document.querySelectorAll('[data-target]').forEach((element) => counterObserver.observe(element));
} else {
    document.querySelectorAll('[data-target]').forEach((element) => animateCounter(element));
}

// Tạo cảm giác nổi cho navbar khi người dùng cuộn trang.
window.addEventListener('scroll', () => {
    const nav = document.getElementById('mainNav') || document.getElementById('panelNav');
    if (!nav) {
        return;
    }
    nav.classList.toggle('shadow-lg', window.scrollY > 10);
});

if (!prefersReducedMotion && window.innerWidth > 768) {
    const heroBg = document.querySelector('.hero-bg');
    if (heroBg) {
        let ticking = false;
        window.addEventListener('scroll', () => {
            if (ticking) {
                return;
            }
            ticking = true;
            window.requestAnimationFrame(() => {
                heroBg.style.transform = `translateY(${window.pageYOffset * 0.3}px)`;
                ticking = false;
            });
        });
    }
}

/**
 * Validation nhẹ phía client:
 * - Chỉ hỗ trợ các kiểm tra cơ bản như required, email, minlength và xác nhận mật khẩu.
 * - Giữ logic ngắn gọn để không chồng chéo với validation bên PHP.
 */
function clearFieldError(field) {
    field.dataset.invalid = 'false';
    const wrapper = field.closest('div');
    const errorNode = wrapper ? wrapper.querySelector('.field-error') : null;
    if (errorNode) {
        errorNode.remove();
    }
}

function renderFieldError(field, message) {
    const wrapper = field.closest('div');
    if (!wrapper) {
        return;
    }
    clearFieldError(field);
    field.dataset.invalid = 'true';
    const errorNode = document.createElement('p');
    errorNode.className = 'field-error';
    errorNode.textContent = message;
    wrapper.appendChild(errorNode);
}

function validateField(field, form) {
    const value = field.value.trim();
    clearFieldError(field);

    if (field.disabled || field.type === 'hidden') {
        return true;
    }
    if (field.hasAttribute('required') && value === '') {
        renderFieldError(field, 'Trường này là bắt buộc.');
        return false;
    }
    if (field.type === 'email' && value !== '' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
        renderFieldError(field, 'Email chưa đúng định dạng.');
        return false;
    }
    if (field.hasAttribute('minlength') && value !== '' && value.length < Number(field.getAttribute('minlength'))) {
        renderFieldError(field, `Vui lòng nhập tối thiểu ${field.getAttribute('minlength')} ký tự.`);
        return false;
    }
    if (field.name === 'confirm_password') {
        const passwordField = form.querySelector('[name="password"]');
        if (passwordField && value !== passwordField.value.trim()) {
            renderFieldError(field, 'Mật khẩu xác nhận chưa khớp.');
            return false;
        }
    }

    return true;
}

document.querySelectorAll('form[data-validate]').forEach((form) => {
    const fields = Array.from(form.querySelectorAll('input, select, textarea'));

    fields.forEach((field) => {
        field.addEventListener('input', () => validateField(field, form));
        field.addEventListener('blur', () => validateField(field, form));
    });

    form.addEventListener('submit', (event) => {
        const isValid = fields.every((field) => validateField(field, form));
        if (!isValid) {
            event.preventDefault();
            const firstInvalidField = form.querySelector('[data-invalid="true"]');
            if (firstInvalidField) {
                firstInvalidField.focus();
            }
        }
    });
});

// Gom confirm vào data attribute để HTML sạch hơn và dễ tái sử dụng.
document.querySelectorAll('[data-confirm]').forEach((element) => {
    element.addEventListener('click', (event) => {
        const message = element.getAttribute('data-confirm') || 'Bạn có chắc chắn muốn tiếp tục?';
        if (!window.confirm(message)) {
            event.preventDefault();
        }
    });
});

/**
 * Bộ lọc giá cho trang rooms:
 * - Chấp nhận cách nhập ngắn như 2, 2.5, 1500, 2 triệu.
 * - Tạo gợi ý động để người dùng không phải nhập đủ số 0.
 * - Tự nới giá kết thúc tối thiểu 500k khi submit để khớp với xử lý PHP.
 */
function parseHumanPriceClient(value) {
    const rawValue = String(value || '').trim();
    if (rawValue === '') {
        return null;
    }

    const normalized = rawValue
        .toLowerCase()
        .replace(/vnđ|vnd|đ|dong|\s+/g, '');
    const numberText = normalized.replace(/[^0-9.,]/g, '');
    if (numberText === '') {
        return null;
    }

    const number = Number(numberText.replace(',', '.'));
    if (!Number.isFinite(number) || number <= 0) {
        return null;
    }

    if (normalized.includes('tr') || normalized.includes('triệu') || number < 1000) {
        return Math.round(number * 1000000);
    }
    if (normalized.includes('k') || normalized.includes('nghin') || normalized.includes('nghìn') || number < 100000) {
        return Math.round(number * 1000);
    }

    return Math.round(number);
}

function formatPriceSuggestion(price) {
    if (!Number.isFinite(price) || price <= 0) {
        return '';
    }

    if (price >= 1000000) {
        const millionValue = price / 1000000;
        const formatted = Number.isInteger(millionValue)
            ? String(millionValue)
            : millionValue.toFixed(1).replace(/\.0$/, '');
        return `${formatted} triệu`;
    }

    return `${Math.round(price / 1000)} nghìn`;
}

function renderPriceSuggestions(listElement, prices) {
    if (!listElement) {
        return;
    }

    listElement.innerHTML = '';
    [...new Set(prices)]
        .filter((price) => Number.isFinite(price) && price > 0)
        .forEach((price) => {
            const option = document.createElement('option');
            option.value = formatPriceSuggestion(price);
            listElement.appendChild(option);
        });
}

function initRoomPriceFilters(form) {
    const startInput = form.querySelector('[data-price-input="start"]');
    const endInput = form.querySelector('[data-price-input="end"]');
    const helper = form.querySelector('[data-price-helper]');
    const startList = document.getElementById('price-suggestion-start');
    const endList = document.getElementById('price-suggestion-end');
    const minimumGap = Number(form.dataset.priceMinGap || 500000);

    if (!startInput || !endInput || !helper) {
        return;
    }

    const baseStartPrices = [1000000, 1500000, 2000000, 2500000, 3000000, 3500000, 4000000];
    const baseEndPrices = [1500000, 2000000, 2500000, 3000000, 3500000, 4000000, 5000000, 6000000];

    const refreshSuggestions = () => {
        const startPrice = parseHumanPriceClient(startInput.value);
        const endPrice = parseHumanPriceClient(endInput.value);
        const nextMinEndPrice = startPrice !== null ? startPrice + minimumGap : 1500000;

        renderPriceSuggestions(startList, [
            ...(startPrice !== null ? [startPrice, startPrice + 500000, startPrice + 1000000] : []),
            ...baseStartPrices,
        ]);

        renderPriceSuggestions(endList, [
            nextMinEndPrice,
            nextMinEndPrice + 500000,
            nextMinEndPrice + 1000000,
            ...(endPrice !== null ? [endPrice] : []),
            ...baseEndPrices,
        ]);

        if (startPrice !== null && endPrice !== null && endPrice < nextMinEndPrice) {
            helper.textContent = 'Khoảng giá tối thiểu cách nhau 500.000đ. Khi tìm kiếm, hệ thống sẽ tự nâng giá kết thúc lên mức phù hợp.';
            helper.className = 'mt-2 text-xs text-amber-700';
            return;
        }

        helper.textContent = 'Nhập ngắn như 2, 2.5, 1500, 2 triệu. Hệ thống luôn giữ khoảng cách tối thiểu 500.000đ.';
        helper.className = 'mt-2 text-xs text-gray-500';
    };

    startInput.addEventListener('input', refreshSuggestions);
    endInput.addEventListener('input', refreshSuggestions);

    form.addEventListener('submit', () => {
        const startPrice = parseHumanPriceClient(startInput.value);
        const endPrice = parseHumanPriceClient(endInput.value);
        if (startPrice !== null && endPrice !== null && endPrice < startPrice + minimumGap) {
            endInput.value = formatPriceSuggestion(startPrice + minimumGap);
        }
    });

    refreshSuggestions();
}

document.querySelectorAll('form[data-room-filter-form]').forEach((form) => {
    initRoomPriceFilters(form);
});

/**
 * Sidebar accordion cho panel (admin/tenant).
 * Nhom menu [data-nav-group]: click vao nut cha de so/thu danh sach con.
 * Animation dung max-height inline de muot va khong giap giat.
 */
(function initPanelNavAccordion() {
    const groups = document.querySelectorAll('[data-nav-group]');
    if (!groups.length) {
        return;
    }

    groups.forEach((group) => {
        const toggle = group.querySelector('.nav-group-toggle');
        const body = group.querySelector('.nav-group-body');
        const chevron = group.querySelector('.nav-group-chevron');
        if (!toggle || !body) {
            return;
        }

        let open = toggle.getAttribute('aria-expanded') === 'true';

        // Chuan hoa trang thai ban dau: bo max-h-0, dung inline max-height.
        body.classList.remove('max-h-0');
        body.style.maxHeight = open ? body.scrollHeight + 'px' : '0px';

        toggle.addEventListener('click', () => {
            open = !open;
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (chevron) {
                chevron.classList.toggle('rotate-180', open);
            }
            body.style.maxHeight = open ? body.scrollHeight + 'px' : '0px';
        });
    });
})();
/**
 * Sidebar admin: trượt ẩn khi chọn mục để mở rộng không gian làm việc.
 * Nút 3 gạch (menu) cạnh logo để kéo sidebar trở lại.
 * Chỉ áp dụng cho các trang admin (page=admin...).
 */
(function initPanelSidebarToggle() {
    if (!/page=admin/.test(window.location.search)) {
        return;
    }
    const aside = document.querySelector('aside.fixed');
    const nav = document.getElementById('panelNav');
    if (!aside || !nav) {
        return;
    }

    const STORAGE_KEY = 'nta_sidebar_hidden';

    const style = document.createElement('style');
    style.textContent = [
        'aside.fixed { transition: transform .3s ease; }',
        'body.sidebar-collapsed aside.fixed { transform: translateX(-100%); }',
        'main { transition: margin-left .3s ease; }',
        'body.sidebar-collapsed main { margin-left: 0 !important; }',
        '@media (max-width: 767px) { #sidebarToggleBtn { display: none; } }'
    ].join('\n');
    document.head.appendChild(style);

    const isHidden = () => {
        try { return localStorage.getItem(STORAGE_KEY) === '1'; } catch (e) { return false; }
    };
    const setHidden = (value) => {
        try { localStorage.setItem(STORAGE_KEY, value ? '1' : '0'); } catch (e) {}
    };

    if (isHidden()) {
        document.body.classList.add('sidebar-collapsed');
    }

    // Nút 3 gạch cạnh logo
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.id = 'sidebarToggleBtn';
    btn.className = 'w-11 h-11 rounded-2xl border border-white/10 bg-white/10 hover:bg-white/20 transition flex items-center justify-center shrink-0';
    btn.title = 'Hiện / ẩn menu quản trị';
    btn.setAttribute('aria-label', 'Hiện hoặc ẩn menu quản trị');
    btn.innerHTML = '<span class="material-symbols-outlined text-white">menu</span>';
    const titleBox = nav.querySelector('.flex.items-center.gap-3.min-w-0');
    if (titleBox) {
        titleBox.prepend(btn);
    }

    btn.addEventListener('click', () => {
        const nowHidden = !document.body.classList.contains('sidebar-collapsed');
        document.body.classList.toggle('sidebar-collapsed', nowHidden);
        setHidden(nowHidden);
    });

    // Chọn mục menu -> ẩn sidebar sau khi chuyển trang để mở rộng không gian
    aside.querySelectorAll('a[href]').forEach((link) => {
        link.addEventListener('click', () => setHidden(true));
    });
})();