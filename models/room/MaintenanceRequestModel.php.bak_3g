<?php
/**
 * Đề xuất bảo trì phòng đang thuê.
 * Bảng: maintenance_requests
 * Luồng: admin đề xuất (pending) → tenant im lặng = đồng ý → tới start_date thì active
 *         (phòng → maintenance). Bất kỳ tenant nào từ chối → rejected, phòng giữ rented.
 */
class MaintenanceRequestModel {

    public static function create($data) {
        $payload = [
            'room_id'       => (int)($data['room_id'] ?? 0),
            'admin_id'      => (int)($data['admin_id'] ?? 0),
            'reason'        => trim((string)($data['reason'] ?? '')),
            'duration_days' => max(1, (int)($data['duration_days'] ?? 1)),
            'start_date'    => trim((string)($data['start_date'] ?? '')) ?: date('Y-m-d'),
            'status'        => 'pending',
        ];
        return (int)Database::insert('maintenance_requests', $payload);
    }

    public static function getById($id) {
        if (!Database::hasConnection()) { return null; }
        $rows = Database::fetchAll('SELECT * FROM maintenance_requests WHERE id = ?', [(int)$id]);
        return !empty($rows) ? $rows[0] : null;
    }

    public static function getPendingByRoom($roomId) {
        if (!Database::hasConnection()) { return null; }
        $rows = Database::fetchAll(
            "SELECT * FROM maintenance_requests WHERE room_id = ? AND status = 'pending' ORDER BY id DESC LIMIT 1",
            [(int)$roomId]
        );
        return !empty($rows) ? $rows[0] : null;
    }

    public static function getActiveByRoom($roomId) {
        if (!Database::hasConnection()) { return null; }
        $rows = Database::fetchAll(
            "SELECT * FROM maintenance_requests WHERE room_id = ? AND status = 'active' ORDER BY id DESC LIMIT 1",
            [(int)$roomId]
        );
        return !empty($rows) ? $rows[0] : null;
    }

    /**
     * Các đề xuất pending đã tới/ngày start_date (phục vụ lazy date-trigger).
     * Controller gọi hàm này khi tải trang, nếu có thì kích hoạt + chuyển phòng sang maintenance.
     */
    public static function getDuePending($asOfDate = null) {
        if (!Database::hasConnection()) { return []; }
        $asOfDate = $asOfDate ?: date('Y-m-d');
        $rows = Database::fetchAll(
            "SELECT * FROM maintenance_requests WHERE status = 'pending' AND start_date <= ? ORDER BY start_date ASC",
            [$asOfDate]
        );
        return is_array($rows) ? $rows : [];
    }

    /** Tenant từ chối → ghi nhận người từ chối, hủy đề xuất. */
    public static function rejectByTenant($id, $userId) {
        return Database::update(
            'maintenance_requests',
            ['status' => 'rejected', 'rejected_by_user_id' => (int)$userId],
            'id = :id AND status = :status',
            ['id' => (int)$id, 'status' => 'pending']
        );
    }

    public static function markActive($id) {
        return Database::update('maintenance_requests', ['status' => 'active'], 'id = :id', ['id' => (int)$id]);
    }

    public static function markCompleted($id) {
        return Database::update('maintenance_requests', ['status' => 'completed'], 'id = :id', ['id' => (int)$id]);
    }

    public static function getAll($filters = []) {
        if (!Database::hasConnection()) { return []; }
        $sql = 'SELECT * FROM maintenance_requests';
        $params = [];
        $conditions = [];
        if (!empty($filters['status'])) {
            $conditions[] = 'status = ?';
            $params[] = $filters['status'];
        }
        if (!empty($filters['room_id'])) {
            $conditions[] = 'room_id = ?';
            $params[] = (int)$filters['room_id'];
        }
        if ($conditions) {
            $sql .= ' WHERE ' . implode(' AND ', $conditions);
        }
        $sql .= ' ORDER BY id DESC';
        $rows = Database::fetchAll($sql, $params);
        return is_array($rows) ? $rows : [];
    }
}